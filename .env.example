# Copy to `.env` and fill in your key(s). The .env file is gitignored.
#
#   cp .env.example .env

# ElevenLabs API key — required by scripts/01_generate_tts.py
# Get one at https://elevenlabs.io/
ELEVENLABS_API_KEY=

# Optional: Copernicus Data Space credentials for the Sentinel-2 fallback
# download path in data-collection/01_sentinel2_download.py
COPERNICUS_USER=
COPERNICUS_PASS=

# Optional: JAXA P-Tree FTP, for Himawari-8/9 AHI. Ten-minute full-disk
# imagery -- the diurnal fire cycle and smoke plume motion that a
# once-or-twice-a-day MODIS/VIIRS overpass cannot see.
# Register at https://www.eorc.jaxa.jp/ptree/
HIMAWARI_FTP_USER=
HIMAWARI_FTP_PASS=
